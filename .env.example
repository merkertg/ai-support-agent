# Только локальные демонстрационные данные. Не используй этот пароль на сервере.
POSTGRES_USER=support
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=ai_support
POSTGRES_PORT=5433
API_PORT=8001
POSTGRES_TEST_PORT=5434

# Для запуска Python на Mac: соединение идёт через опубликованный порт БД.
DATABASE_URL=postgresql+psycopg://support:local-development-only@127.0.0.1:5433/ai_support

# Для api и migrate в Compose: db — имя сервиса внутри Docker-сети.
DATABASE_URL_DOCKER=postgresql+psycopg://support:local-development-only@db:5432/ai_support

# Этап 04: mock работает без сети и не вызывает реальную модель.
# Для OpenAI явно выбери openai, укажи свой ключ и доступный ID модели.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200

# Этап 05: пределы одного запуска агента для mock и openai.
# Шаги — обращения к модели; вызовы — инструменты; время — весь цикл в секундах.
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=60
