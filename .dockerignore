# Локальное окружение пересоздаётся внутри Linux-образа из uv.lock.
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Не отправляем Docker историю Git, настройки и секреты разработчика.
.git/
.github/
.gitignore
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
*.log

# В runtime нужны app/, migrations/, knowledge/ и alembic.ini; Compose не нужен.
# Тесты и инструкции проверяются в CI вне финального образа.
tests/
scripts/
docs/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Локальный Compose-стенд и отчёты не нужны при сборке образа.
compose.yaml
reports/
